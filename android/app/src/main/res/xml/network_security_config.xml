<network-security-config>
    <!-- Allow cleartext (HTTP) traffic.
         BotConnector connects to BotConnector Local and other local LLM servers
         on the user's LAN via HTTP. Users enter the server URL themselves. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
